# Copy to a private local environment file. Production uses /opt/nalanda/.ai.env.
# The worker deliberately receives no Supabase service-role key or Redis URL.
NODE_ENV=development
AI_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_APP_URL=http://localhost:5173
MATERIAL_AI_FAKE_PROVIDER=false
MATERIAL_AI_TEMP_ROOT=/tmp/nalanda-material-ai
MATERIAL_AI_TEMP_MIN_FREE_BYTES=536870912
MATERIAL_AI_JOB_TEMP_LIMIT_BYTES=1073741824
MATERIAL_AI_MAX_CHARACTERS=400000
MATERIAL_AI_LIBREOFFICE_TIMEOUT_SECONDS=120
MATERIAL_AI_PROVIDER_TIMEOUT_SECONDS=180
MATERIAL_AI_PROVIDER_MAX_ATTEMPTS=4
MATERIAL_AI_PROVIDER_RETRY_BASE_SECONDS=2
MATERIAL_AI_PROVIDER_RETRY_MAX_SECONDS=60
MATERIAL_AI_GENERATION_MAX_TOKENS=30000
MATERIAL_AI_KNOWLEDGE_MAX_TOKENS=30000
MATERIAL_AI_RESUME_TTL_SECONDS=86400
MATERIAL_AI_JOB_TIMEOUT_SECONDS=1200
MATERIAL_AI_GRADING_TIMEOUT_SECONDS=240
