# Copy to .env (local development); .env is gitignored, never commit it
PORT=3000
# API request protection and the points abuse scanner require Redis. Production
# uses a password-protected private compose service; this no-password URL is
# only suitable for a disposable local Redis.
REDIS_URL=redis://localhost:6379/15
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
POINT_ABUSE_SCANNER_ENABLED=false
POINT_ABUSE_SCAN_INTERVAL_SECONDS=300
AI_SERVICE_URL=http://localhost:8000
AI_CALLBACK_BASE_URL=http://localhost:3000/api
AI_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
FEATURE_MATERIAL_AI=false
FEATURE_MATERIAL_AI_LUNA=false
MATERIAL_AI_LUNA_ALLOWED_EXTENSIONS=pdf,png
MATERIAL_AI_LUNA_DISABLED_REASON_CODE=AI_LUNA_DISABLED
MATERIAL_AI_MONTHLY_BUDGET_USD=20
MATERIAL_AI_GENERATION_MAX_COST_USD=0.50
MATERIAL_AI_GRADING_MAX_COST_USD=0.05
MATERIAL_AI_RESUME_TTL_SECONDS=86400

# Supabase (Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # Backend only, top secret
SUPABASE_JWT_SECRET=  # Only needed by legacy HS256 projects; leave empty for JWKS projects

# Public links and staged Courses switches (off by default in production; must be enabled explicitly)
PUBLIC_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
FEATURE_LEARNING_COURSES_ENABLED=true
FEATURE_COURSE_SHARING_ENABLED=true
FEATURE_COURSE_MARKET_ENABLED=true
FEATURE_PRONUNCIATION_ENABLED=false
FEATURE_LEARNING_AUDIO_PREWARM_ENABLED=false
FEATURE_SPELLING_TRANSLATION_ASSESSMENT_ENABLED=false

# Azure Speech (API environment only; without it, courses still use browser speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_TIMEOUT_MS=10000
AZURE_SPEECH_PRONUNCIATION_PASS_SCORE=70
AZURE_SPEECH_CIRCUIT_OPEN=false
AZURE_SPEECH_ASSESSMENTS_PER_MINUTE=30
AZURE_SPEECH_ASSESSMENTS_PER_DAY=300
AZURE_SPEECH_MONTHLY_BUDGET_MICRO_USD=5000000
AZURE_SPEECH_TTS_REQUESTS_PER_MINUTE=20
AZURE_SPEECH_TTS_MONTHLY_CHAR_LIMIT=500000
AZURE_SPEECH_TTS_MICRO_USD_PER_1000_CHARS=16000
AZURE_SPEECH_ASSESSMENT_MICRO_USD=2500
LEARNING_AUDIO_PREWARM_INTERVAL_MS=3100
LEARNING_AUDIO_SYNTHESIS_VERSION=1

# OpenRouter (API environment only; used for optional semantic translation checks before spelling)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=12000
# Used only by the protected-release live Ox Alpha translation gate; app requests still use the per-request budget above.
OPENROUTER_SMOKE_MAX_ATTEMPTS=5
OPENROUTER_SMOKE_RETRY_BASE_MS=5000
OPENROUTER_SMOKE_RETRY_MAX_MS=60000
OPENROUTER_ASSESSMENTS_PER_MINUTE=20
OPENROUTER_ASSESSMENTS_PER_DAY=500
OPENROUTER_STT_MODEL=fish-audio/transcribe-1
OPENROUTER_STT_LANGUAGE=zh
OPENROUTER_STT_TIMEOUT_MS=15000
OPENROUTER_STT_REQUESTS_PER_MINUTE=20
OPENROUTER_STT_REQUESTS_PER_DAY=300
OPENROUTER_STT_MONTHLY_BUDGET_MICRO_USD=5000000
OPENROUTER_STT_MICRO_USD_PER_SECOND=100

# Course Market governance
COURSE_MARKET_DAILY_PUBLISH_LIMIT=5
COURSE_REPORT_DAILY_LIMIT=20
COURSE_REPORT_ALERT_THRESHOLD=3
COURSE_MARKET_ADMIN_USER_IDS=
# Points moderation uses its own allowlist. During the compatibility window it
# falls back to COURSE_MARKET_ADMIN_USER_IDS when this value is empty.
MODERATION_ADMIN_USER_IDS=

# Only automated tests may set true; every shared/production environment must leave it unset or false
AZURE_SPEECH_FAKE=false
OPENROUTER_FAKE=false
