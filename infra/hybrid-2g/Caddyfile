# Caddy — single entry point + automatic HTTPS (Let's Encrypt)
# Only this service exposes 80/443; api / ai / redis stay on the internal network.
# Prerequisites: DOMAIN resolves to this host's public IP and ports 80/443 are open.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Backend API (including the Stripe webhook: POST {$DOMAIN}/api/payments/webhook)
	handle /api/* {
		reverse_proxy api:3000
	}

	# Everything else goes to the frontend SPA; History routes fall back to index.html
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
