# Copy to .env and fill in real values (.env is gitignored; never commit it)

# ── Domain and HTTPS ──
DOMAIN=nalanda.example.com
ACME_EMAIL=you@example.com

# ── Supabase (hosted free tier; get these from the supabase.com project Settings → API) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...            # Safe for the frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # Backend only; never leak it or ship it to the frontend
SUPABASE_JWT_SECRET=                       # Fallback verification for legacy HS256 projects only; leave empty for JWKS projects

# ── Courses / Azure Speech (injected into the API container only) ──
PUBLIC_ORIGIN=https://nalanda.example.com
CORS_ALLOWED_ORIGINS=https://nalanda.example.com
FEATURE_LEARNING_COURSES_ENABLED=false
FEATURE_COURSE_SHARING_ENABLED=false
FEATURE_COURSE_MARKET_ENABLED=false
FEATURE_PRONUNCIATION_ENABLED=false
FEATURE_LEARNING_AUDIO_PREWARM_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_TIMEOUT_MS=10000
AZURE_SPEECH_CIRCUIT_OPEN=false
AZURE_SPEECH_ASSESSMENTS_PER_MINUTE=30
AZURE_SPEECH_ASSESSMENTS_PER_DAY=300
AZURE_SPEECH_MONTHLY_BUDGET_MICRO_USD=5000000
AZURE_SPEECH_TTS_REQUESTS_PER_MINUTE=20
AZURE_SPEECH_TTS_MONTHLY_CHAR_LIMIT=500000
AZURE_SPEECH_TTS_MICRO_USD_PER_1000_CHARS=16000
AZURE_SPEECH_ASSESSMENT_MICRO_USD=2500
LEARNING_AUDIO_PREWARM_INTERVAL_MS=3100
LEARNING_AUDIO_SYNTHESIS_VERSION=1
COURSE_MARKET_DAILY_PUBLISH_LIMIT=5
COURSE_REPORT_DAILY_LIMIT=20
COURSE_REPORT_ALERT_THRESHOLD=3
COURSE_MARKET_ADMIN_USER_IDS=
# AZURE_SPEECH_FAKE is for automated tests only and must never be true in production.

# ── Materials AI candidates (production must split these into separate API/AI env files) ──
FEATURE_MATERIAL_AI=false
FEATURE_MATERIAL_AI_LUNA=false
MATERIAL_AI_LUNA_ALLOWED_EXTENSIONS=pdf,png
MATERIAL_AI_LUNA_DISABLED_REASON_CODE=AI_LUNA_DISABLED
OPENROUTER_API_KEY=
AI_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
MATERIAL_AI_MONTHLY_BUDGET_USD=20
MATERIAL_AI_GENERATION_MAX_COST_USD=0.50
MATERIAL_AI_GRADING_MAX_COST_USD=0.05

# ── Internal services (usually unchanged; production Redis must have a password) ──
REDIS_URL=redis://redis:6379/15
AI_SERVICE_URL=http://ai:8000
