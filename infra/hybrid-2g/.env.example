# 复制为 .env 并填写真实值（.env 已被 .gitignore，切勿提交）

# ── 域名与 HTTPS ──
DOMAIN=nalanda.example.com
ACME_EMAIL=you@example.com

# ── Supabase（云端免费档；在 supabase.com 项目 Settings → API 获取）──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...            # 可进前端
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # 仅后端，切勿泄露 / 进前端
SUPABASE_JWT_SECRET=super-secret-jwt       # NestJS 验签用

# ── Claude（Anthropic Console → API Keys）──
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe（Dashboard → Developers）──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 内部服务（一般无需改动）──
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai:8000
